WORKBENCH_TOKEN=dev-local-token
# Buckets workspaces per authenticated principal under WORKBENCH_WORKSPACE_ROOT/<namespace>/...
WORKBENCH_LOCAL_USER_NAMESPACE=_local
WORKBENCH_WORKSPACE_ROOT=
# Production: restrict file access to managed workspaces only (set to same path as WORKBENCH_WORKSPACE_ROOT).
WORKBENCH_ALLOWED_ROOTS=
# Clerk session JWT verification (optional). When unset, only WORKBENCH_TOKEN is accepted.
WORKBENCH_CLERK_JWKS_URL=
WORKBENCH_CLERK_ISSUER=
# If Clerk is enabled, keep this false for strict per-user isolation.
WORKBENCH_ALLOW_LEGACY_TOKEN_WITH_CLERK=false
WORKBENCH_DEFAULT_MODEL=openai:accounts/fireworks/models/qwen3p6-plus
WORKBENCH_LANGSMITH_TRACING=false

# Fireworks (recommended): used for reasoning + tool calling.
FIREWORKS_API_KEY=
# Optional override (defaults to this value automatically for Fireworks models).
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1

# Optional provider keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BASETEN_API_KEY=

# Optional remote sandbox placeholder. Remote sandbox mode is disabled until set.
WORKBENCH_REMOTE_SANDBOX_URL=
WORKBENCH_REMOTE_SANDBOX_TOKEN=
