WORKBENCH_TOKEN=dev-local-token
WORKBENCH_WORKSPACE_ROOT=
WORKBENCH_ALLOWED_ROOTS=
WORKBENCH_DEFAULT_MODEL=openai:accounts/fireworks/models/qwen3p6-plus
WORKBENCH_LANGSMITH_TRACING=false

# Fireworks (recommended): used for reasoning + tool calling.
FIREWORKS_API_KEY=
# Optional override (defaults to this value automatically for Fireworks models).
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1

# Optional provider keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BASETEN_API_KEY=

# Optional remote sandbox placeholder. Remote sandbox mode is disabled until set.
WORKBENCH_REMOTE_SANDBOX_URL=
WORKBENCH_REMOTE_SANDBOX_TOKEN=
