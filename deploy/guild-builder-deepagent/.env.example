# Required for deploy / LangSmith
LANGSMITH_API_KEY=

# Fireworks via OpenAI-compatible adapter (matches repo .env.example + agents.py).
# For openai:accounts/fireworks/models/* models, set Fireworks key and base URL like the workbench.
FIREWORKS_API_KEY=
# deepagents-cli validates OPENAI_API_KEY for openai:* models — use the same value as FIREWORKS_API_KEY.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1

# Optional: other providers if you change [agent].model
# ANTHROPIC_API_KEY=

# Tavily MCP (see mcp.json); optional if you remove search MCP
TAVILY_API_KEY=

# Optional sandbox providers
# DAYTONA_API_KEY=
